# vLLM on mandelbrot has max_model_len=32000; qwen-code defaults to
# requesting 32768 output tokens, which the server rejects. Cap it below
# the model's context window (mirrors opencode's output:16384 limit,
# lowered here because qwen-code's full tool/system prompt is large).
QWEN_CODE_MAX_OUTPUT_TOKENS=8192
