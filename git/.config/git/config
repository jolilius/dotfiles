[core]
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	# Status & navigation
	st      = status -sb
	br      = branch -vv
	brd     = branch -d
	brD     = branch -D
	merged  = branch --merged
	last    = log -1 HEAD --stat
	co      = checkout
	coo     = !git fetch && git checkout
	cob     = checkout -b

	# Log / history
	lg      = log --oneline --graph --decorate --all
	lp      = log --oneline -20
	ls      = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll      = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	lu      = log --pretty=format:"%h:%s"
	who     = shortlog -sn --no-merges

	# Commit shortcuts
	aa      = add -A .
	cm      = commit -m
	aacm    = !git add -A . && git commit -m
	ca      = commit --amend --no-edit
	amend   = commit --amend -m
	addtolastcommit = !git add -A && git commit --amend --no-edit
	cp      = cherry-pick

	# Undo / fixup
	undo    = reset --soft HEAD~1
	undolastcommit = !git reset --soft HEAD^
	unstage = restore --staged
	wip     = !git add -A && git commit -m "WIP [skip ci]"
	unwip   = !git log -1 --format='%s' | grep -q 'WIP' && git reset HEAD~1

	# Push / pull
	po      = push origin
	pu      = !git push origin `git branch --show-current`
	poh     = push origin HEAD
	plo     = pull origin
	ploh    = pull origin HEAD

	# Housekeeping
	aliases = config --get-regexp '^alias\\.'
	ignored = ls-files --others --ignored --exclude-standard
	gone    = !git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d
	f       = "!git ls-files | grep -i"
	gr      = grep -Ii

